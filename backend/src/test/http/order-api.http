### 1. LOGIN (Get JWT Token)
# Authenticates and stores the token in an IntelliJ global variable
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "admin@lavurger.com",
  "password": "1234"
}

> {%
    client.global.set("auth_token", response.body.token);
%}


### 2. CREATE ORDER (DINE_IN via QR)
# Main flow: Customer sends only tableId and items.
# The server calculates total, generates ID, and creates the order number.
POST http://localhost:8080/api/orders
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "tableId": 1,
  "items": [
    { "productId": 1, "quantity": 2 },
    { "productId": 4, "quantity": 1 }
  ]
}

> {%
    client.global.set("created_order_id", response.body.id);
%}


### 3. GET ALL ORDERS
# General view for administration/management
GET http://localhost:8080/api/orders
Authorization: Bearer {{auth_token}}
Accept: application/json


### 4. FILTER BY STATUS: RECEIVED
# Kitchen Monitor: View only new incoming orders
GET http://localhost:8080/api/orders?status=RECEIVED
Authorization: Bearer {{auth_token}}
Accept: application/json


### 5. FILTER BY STATUS: PREPARING
# View orders currently being cooked
GET http://localhost:8080/api/orders?status=PREPARING
Authorization: Bearer {{auth_token}}
Accept: application/json


### 6. UPDATE STATUS TO "PREPARING"
# Uses the ID captured in Step 2
PATCH http://localhost:8080/api/orders/{{created_order_id}}/status
Authorization: Bearer {{auth_token}}
Content-Type: application/json

"PREPARING"


### 7. UPDATE STATUS TO "COMPLETED"
# Marks the order as finished/delivered
PATCH http://localhost:8080/api/orders/{{created_order_id}}/status
Authorization: Bearer {{auth_token}}
Content-Type: application/json

"COMPLETED"


### 8. VALIDATION TEST: NON-EXISTENT TABLE
# Should return 404 Resource Not Found
POST http://localhost:8080/api/orders
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "tableId": 999,
  "items": [
    { "productId": 1, "quantity": 1 }
  ]
}


### 9. VALIDATION TEST: NON-EXISTENT PRODUCT
# Should return 404 Resource Not Found
POST http://localhost:8080/api/orders
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "tableId": 1,
  "items": [
    { "productId": 9999, "quantity": 1 }
  ]
}


### 10. VALIDATION TEST: EMPTY CART
# Should return 400 Bad Request
POST http://localhost:8080/api/orders
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "tableId": 1,
  "items": []
}