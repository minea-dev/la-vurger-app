{
  "name": "La Vurger",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:client": "ng serve lavurger-client",
    "start:admin": "ng serve lavurger-admin --port 4201",
    "build:client": "ng build lavurger-client --configuration production",
    "build:admin": "ng build lavurger-admin --configuration production --base-href /admin/",
    "build:all": "npm run build:client && npm run build:admin",
    "build": "npm run build:all",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx/signals": "^21.0.1",
    "@stomp/rx-stomp": "^2.3.0",
    "@stomp/stompjs": "^7.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
